# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (kept behind a single server-side adapter; do not read this on the client)
ANTHROPIC_API_KEY=
# Only needed for an identity-linked API key (Console SSO), which the
# Anthropic API rejects without a workspace id. A plain workspace API key
# doesn't need this.
ANTHROPIC_WORKSPACE_ID=
